{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd backend && python3 -m venv /app/venv && /app/venv/bin/pip install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "cd backend && /app/venv/bin/uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
