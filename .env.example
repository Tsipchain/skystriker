# SkyStriker - Required Environment Variables for Railway
# Copy to Variables tab in Railway

# Database (Railway provides this automatically if you add PostgreSQL)
DATABASE_URL=postgresql://user:pass@host:5432/skystriker

# Auth
JWT_SECRET_KEY=your-super-secret-key-change-me

# Optional
ENVIRONMENT=production
DEBUG=false
PORT=8000

# CORS (add your frontend domain)
CORS_ALLOW_ORIGINS=https://skystriker.up.railway.app,http://localhost:5173

# AI (optional)
OPENAI_API_KEY=

# ether.fi
ETHERFI_REFERRAL_URL=https://www.ether.fi/refer/74df90a0
ETHERFI_API_KEY=

# Weather (optional - for tour planning)
WEATHER_API_KEY=

# Email (optional)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
