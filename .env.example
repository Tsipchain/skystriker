# Core app settings
APP_NAME=Thronos Chain SkyStriker Global Guides
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
# Optional locally because the app falls back to SQLite.
# Required in production (Railway) for persistent PostgreSQL storage.
DATABASE_URL=

# Verification provider
VERIFYID_BASE_URL=https://verifyid.thronos.example/api
VERIFYID_PROVIDER_LABEL=VerifyID

# Demo/bootstrap behavior
SEED_DEMO_DATA=true
DEFAULT_COUNTRY_CODE=gr

# Google OAuth (Google Identity Services)
# Required in production for Google Sign-In to work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
